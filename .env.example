# Copie para .env (que não vai para o Git) e troque os valores.
# O docker-compose lê este arquivo automaticamente.
DB_USER=parolin
DB_PASSWORD=troque-esta-senha
# Use 5433 se já houver outro PostgreSQL na porta 5432.
DB_PORT=5432

# A aplicação NÃO lê o .env sozinha: defina estas variáveis no terminal
# antes de rodar (veja o README).
# DB_URL=jdbc:postgresql://localhost:5432/parolin   (opcional em dev; obrigatória em prod)
# APP_ADMIN_USER=coordenacao
# APP_ADMIN_PASSWORD=uma-senha-com-10-ou-mais-caracteres
# APP_DEMO_PASSWORD=outra-senha-com-10-ou-mais
